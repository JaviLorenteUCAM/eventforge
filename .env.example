# ============================================================================
# EventForge · Variables de entorno del FRONTEND
# ----------------------------------------------------------------------------
# Copia este fichero a `.env` y rellena los valores.
#
#   cp .env.example .env        (Linux / macOS)
#   copy .env.example .env      (Windows CMD)
#   Copy-Item .env.example .env (PowerShell)
#
# IMPORTANTE: `.env` NUNCA se sube a Git (ya está en .gitignore).
# Solo las variables que empiezan por VITE_ llegan al navegador.
# ============================================================================

# --- Supabase (Project Settings -> Data API / API Keys) ---------------------
# URL del proyecto. Ej: https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Clave pública "anon". Es segura de publicar: sin sesión no da acceso a nada
# porque todas las tablas tienen Row Level Security.
VITE_SUPABASE_ANON_KEY=

# Nombre que se muestra en la aplicación (opcional)
VITE_APP_NAME=EventForge


# ============================================================================
# SOLO PARA SCRIPTS LOCALES (npm run seed). NO se envían al navegador.
# ----------------------------------------------------------------------------
# La service_role key salta TODAS las políticas de seguridad.
# No la pegues nunca en el código, ni en el panel de Vercel, ni la compartas.
# ============================================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Código de acceso del espacio de trabajo. Debe coincidir con el secreto
# ACCESS_CODE configurado en la Edge Function `access`.
ACCESS_CODE=
